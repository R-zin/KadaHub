# KadaHub Frontend Environment Variables (Vercel / Local)
# Public variables only — NEVER place server secrets here!

# Production backend API URL (e.g. https://your-api-domain.com or leave unset for relative /api)
VITE_API_URL=http://localhost:4000/api

# Razorpay Public Key ID (Key Secret must NEVER appear in frontend variables)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
