# ------------------------------------------------------------------
# KadaHub API configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000

# PostgreSQL (Supabase) connection string.
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the "Session" pooler URI for the app and keep `sslmode=require`.
# Example:
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/kadahub

# TLS for the DB connection. Auto-on for Supabase/remote hosts; set false for local.
# DB_SSL=false

# Database initialization at startup (schema.sql is always applied; it is idempotent).
# SEED_ON_INIT:  true = always seed on boot, false = schema only.
#                unset = seed only when the database is empty (default).
# DB_INIT=false: skip all DB initialization at startup.
# SEED_ON_INIT=
# DB_INIT=

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m            # session length; matches 15-min inactivity logout
BCRYPT_ROUNDS=10

# CORS: comma-separated list of allowed origins or CLIENT_URL for production
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
CLIENT_URL=https://your-vercel-domain.vercel.app

# File storage ("local" for local disk; "supabase" for Supabase Storage bucket)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Payment gateway ("mock" for automated tests/dev; "razorpay" for production)
PAYMENT_DRIVER=mock
PAYMENT_CURRENCY=inr
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_optional
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# AI Virtual Try-On
#   "mock"  -> returns the product image (no ML; for dev/tests)
#   "modal" -> calls the IDM-VTON model deployed on Modal (see modal/tryon_app.py)
TRYON_DRIVER=mock
# Modal web endpoint URL for the `api` function, printed by `modal deploy modal/tryon_app.py`
# e.g. https://<workspace>--kadahub-tryon-api.modal.run/v1/tryon
TRYON_MODAL_URL=
# Bearer token; must match the TRYON_API_TOKEN in the Modal secret `kadahub-tryon`
TRYON_API_TOKEN=
# Inference tuning (optional)
# TRYON_STEPS=30
# TRYON_TIMEOUT_MS=180000

# Notifications ("console" now; an email/SMS provider later)
NOTIFICATION_DRIVER=console
